{{template "top" .}}

<div class="container form">
    <form>
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <div class="position-relative">
                    <label for="from-input" class="form-label">From</label>
                    <input id="from-input" type="text" class="form-control" name="from-input" autocomplete="off" placeholder="Enter origin port">
                    <div class="from-autocomplete-items autocomplete-items"></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="position-relative">
                    <label for="to-input" class="form-label">To</label>
                    <input id="to-input" type="text" class="form-control" name="to-input" autocomplete="off" placeholder="Enter destination port">
                    <div class="to-autocomplete-items autocomplete-items"></div>
                </div>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">Calculate</button>
            </div>
        </div>
    </form>
</div>

<button type="button" class="btn btn-primary btn-floating" id="download-button" disabled>
    <i class="fa fa-download"></i>
</button>

<button type="button" class="btn btn-primary btn-floating" id="clear-button">
    <i class="fa fa-times"></i>
</button>

{{/*Map Box*/}}
<div id="map"></div>

{{template "bottom" .}}