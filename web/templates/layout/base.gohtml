{{define "top"}}
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <!-- Required meta tags -->
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

        <!-- Cookie Consent by PrivacyPolicies.com https://www.PrivacyPolicies.com -->
        <script type="text/javascript" src="//www.privacypolicies.com/public/cookie-consent/4.0.0/cookie-consent.js" charset="UTF-8"></script>
        <script type="text/javascript" charset="UTF-8">
            document.addEventListener('DOMContentLoaded', function () {
                cookieconsent.run({"notice_banner_type":"simple","consent_type":"implied","palette":"light","language":"en","page_load_consent_levels":["strictly-necessary","functionality","tracking","targeting"],"notice_banner_reject_button_hide":false,"preferences_center_close_button_hide":false,"page_refresh_confirmation_buttons":false,"website_name":"Searoute"});
            });
        </script>

        <!-- App Configuration -->
        <script>
            window.__APP_CONFIG__ = {
                owmApiKey: "{{ .owmApiKey }}",
                cartoApiKey: "{{ .cartoApiKey }}",
            };
        </script>

        <!-- Google Analytics (only if tracking ID is configured) -->
        {{ if .gaTrackingID }}
        <script type="text/plain" cookie-consent="tracking" async src="https://www.googletagmanager.com/gtag/js?id={{ .gaTrackingID }}"></script>
        <script type="text/plain" cookie-consent="tracking">
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '{{ .gaTrackingID }}');
        </script>
        {{ end }}


        <!-- Goat counter -->
        <script data-goatcounter="https://searoute.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>


        <noscript>Cookie Consent by <a href="https://www.privacypolicies.com/" rel="noopener">Privacy Policies website</a></noscript>
        <!-- End Cookie Consent -->

        <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">

        <!-- Leaflet CSS -->
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.3/dist/leaflet.css"
              integrity="sha256-kLaT2GOSpHechhsozzB+flnD+zUyjE2LlfWPgU04xyI="
              crossorigin=""/>

        <!-- Leaflet JS -->
        <script src="https://unpkg.com/leaflet@1.9.3/dist/leaflet.js"
                integrity="sha256-WBkoXOwTeyKclOHuWtc+i2uENFpDZ9YPdf5Hf+D7ewM="
                crossorigin=""></script>

        <!-- GeoJSON Vector Tiles (UMD build - creates window.geojsonvt) -->
        <script src="https://unpkg.com/geojson-vt@3.2.1/geojson-vt-dev.js"></script>
        <script src="./static/leaflet-geojson-vt.js"></script>

        <!-- Include Leaflet.markercluster CSS and JS -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.1/MarkerCluster.css" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.1/MarkerCluster.Default.css" />
        <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.1/leaflet.markercluster.js"></script>

        <!-- Spinner -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/spin.js/2.3.2/spin.min.js"></script>

        <!-- Font Awesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.3.0/css/all.min.css" integrity="sha512-SzlrxWUlpfuzQ+pcUCosxcglQRNAq/DZjVsC0lE40xsADsfeQoEypE+enwcOiGjk/bSuGGKHEyjSoQ1zVisanQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />

        <!-- Notie Notification CSS -->
        <link rel="stylesheet" type="text/css" href="https://unpkg.com/notie@4.3.1/dist/notie.min.css">

        <!-- Own Styles -->
        <link rel="stylesheet" href="./static/style.css">

        <!-- Favicon -->
        <link rel="icon" type="image/x-icon" href="./static/icons/icons8-waypoint-map-96.png">

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Montserrat&display=swap" rel="stylesheet">

        <!-- Title -->
        <title>Short Sea Route</title>

    </head>
    <body>
    <header>
        <!-- Bootstrap navbar -->
        <nav class="navbar navbar-dark bg-primary">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" href="/">
                    <img src="./static/icons/logo.png" width="40" height="40" class="me-2" alt="Logo">
                    <span>Short Sea Route</span>
                </a>
                <ul class="navbar-nav ms-auto d-flex flex-row">
                    <li class="nav-item"><a class="nav-link text-white" href="/about">About Me</a></li>
                </ul>
            </div>
        </nav>
    </header>
    <main>
{{ end }}

{{define "bottom"}}
    </main>
    <footer>
        <div class="page-footer bg-primary text-white">
            <div class="container d-flex justify-content-between align-items-center h-100">
                <span>&copy; 2022 CaptV89</span>
                <div>
                    <a class="text-white-50" href="https://github.com/captv89/seaRoute" target="_blank">Github</a>
                    <span class="text-white-50 mx-1">|</span>
                    <a class="text-white-50" href="#" id="open_preferences_center">Update cookies preferences</a>
                </div>
            </div>
        </div>

        <!-- Bootstrap JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN" crossorigin="anonymous"></script>

        <!-- Notie Notification JS -->
        <script src="https://unpkg.com/notie@4.3.1/dist/notie.min.js" crossorigin="anonymous"></script>

        <!-- Custom JS -->
        <script src="./static/script.js"></script>

        <!-- Notifications -->
        <script>
            {{with .Error}}
            notie.alert({type: 'error', text: '{{.}}', time: 5});
            {{end}}

            {{with .Flash}}
            notie.alert({type: 'success', text: '{{.}}', time: 5});
            {{end}}

            {{with .Warning}}
            notie.alert({type: 'warning', text: '{{.}}', time: 5});
            {{end}}
        </script>

    </footer>
    </body>
</html>
{{end}}